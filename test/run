#!/usr/bin/env bash
# shellcheck shell=bash
# vi:ft=sh fdm=marker ts=2 sw=2 et

# Test runner for the scripts and bash config.
#
# Usage:
#   ./test/run [test_file_or_dir ...]
#
# Runs every .bats file in test/bash when no arguments are given.
#
# Environment:
#   TEST_JOBS  parallel jobs (default: detect via nproc; 1 forces serial)
#   CI         when set, emit TAP output

set -euo pipefail

TEST_DIR="$(cd "$(dirname "$0")" && pwd)"
TEST_DEPS_DIR="${TEST_DIR}/../test_lib"
BASH_CONFIG_DIR="$(cd "${TEST_DIR}/../config/bash" && pwd)"
export TEST_DIR TEST_DEPS_DIR BASH_CONFIG_DIR

bats_executable="${TEST_DEPS_DIR}/bats-core/bin/bats"

# Fetch bats only if it isn't checked out yet.
if [[ ! -x $bats_executable ]]; then
  git submodule update --init --recursive
fi

# Which tests do we run?
if [[ $# -eq 0 ]]; then
  test_targets=("${TEST_DIR}/bash")
else
  test_targets=("$@")
fi

bats_args=(--abort)
if [[ -n ${CI:-} ]]; then
  bats_args+=(--tap)
fi

# bats only supports --jobs with GNU parallel (not moreutils' parallel).
has_gnu_parallel() {
  command -v parallel &> /dev/null \
    && [[ "$(parallel --version 2> /dev/null | head -n 1)" == "GNU parallel"* ]]
}

test_jobs="${TEST_JOBS:-detect}"
if [[ $test_jobs == detect ]]; then
  test_jobs="$(nproc 2> /dev/null || echo 2)"
fi

if (( test_jobs > 1 )) && has_gnu_parallel; then
  bats_args+=(--jobs "$test_jobs" --no-parallelize-within-files)
fi

exec "$bats_executable" "${bats_args[@]}" "${test_targets[@]}"
