#!/usr/bin/env bash
# shellcheck shell=bash
# vi:ft=sh fdm=marker ts=2 sw=2 et

# If not running interactively, don't do anything
[[ $- != *i* ]] && return 1

if (( ${BASH_VERSINFO[0]:-0} < 5 )); then
  echo "Error: This config requires bash >= 5 (found: ${BASH_VERSION:-unknown})" >&2
  return 51
fi

# lib/navigate.bash - browse prompts and outputs in a pager (alternate screen)
nav() {
  [[ -n ${TMUX-} ]] || { printf 'nav: needs tmux\n' >&2; return 1; }
  {
    tmux capture-pane -p -J -S -
    printf '\n%.0s' $(seq 1 "${LINES:-50}")
  } | less -j5 $'+G?^╭─\n'
}

bind -m vi-command -x '"\C-x": nav'      # Ctrl-X then n

_errlog="${XDG_RUNTIME_DIR:-/tmp}/dotfiles-errors.$$"
alias inspect='cat "${_errlog}"'

DOTFILES_BASH_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bash"

# VTE's hook also sets the window title, which fights with PS1's title.
# Keep only the cwd report (OSC 7).
if declare -F __vte_osc7 >/dev/null; then
  __vte_prompt_command() { printf '%s' "$(__vte_osc7)"; }
fi

# Early theme replay: repaint the cached palette before anything slow loads,
# so the terminal's default colors don't flash at startup. __theme::init
# re-applies the real palette later, so a stale cache fixes itself.
# Needs THEME_VARIANT set to dark/light (cache is keyed by it).
if [[ -t 1 && -z ${SSH_CONNECTION-} && -z ${TMUX-} ]]; then
  __f=${XDG_CACHE_HOME:-$HOME/.cache}/bash-theme-${THEME_VARIANT:-dark}.seq
  if [[ -r $__f ]]; then
    IFS= read -r -d '' __s < "$__f"   # returns non-zero at EOF, that's expected
    printf '%s' "$__s"
  fi
  unset __f __s
fi

{

source "${XDG_DATA_HOME:-$HOME/.local/share}/bashlib/lib.bash"
import_lib "common" "log" "path"

for _rc in "${DOTFILES_BASH_CONFIG_DIR}"/{lib/*,core/*,bash_plugins,bash_aliases,bash_functions}; do
  [[ -f $_rc ]] || continue
  case $_rc in
    # Env-style files: plain KEY=value lines, shared with environment.d via
    # symlinks, so they contain no `export`. Auto-export them while sourcing.
    */core/10-xdg.sh | */core/20-envars.bash)
      set -a
      source "$_rc"
      set +a
      ;;
    *)
      source "$_rc"
      ;;
  esac
done
unset _rc


__pe::load_conf
__theme::init "${THEME_NAME:-default}"

if [[ -s $_errlog ]]; then
  echo "Using Minimal config"
  source "$DOTFILES_BASH_CONFIG_DIR/bashrc_minimal"
fi

# local config file
local_bashrc="${DOTFILES_BASH_CONFIG_DIR}/bashrc_local"
if [[ -f "${local_bashrc}" ]]; then
  source "${local_bashrc}" || echo "Warning: failed to load basrc_local" >&2
fi
unset local_bashrc

unset DOTFILES_BASH_CONFIG_DIR

} 2> "$_errlog"


if [[ -s $_errlog ]]; then
  printf 'bashrc: load errors (run: inspect)\n' >&2
else
  rm -f "$_errlog"
fi
