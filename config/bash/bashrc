#!/usr/bin/env bash
# shellcheck shell=bash
# vi:ft=sh fdm=marker ts=2 sw=2 et

# If not running interactively, don't do anything
[[ $- != *i* ]] && return 1

if (( ${BASH_VERSINFO[0]:-0} < 5 )); then
  echo "Error: This config requires bash >= 5 (found: ${BASH_VERSION:-unknown})" >&2
  return 51
fi

_errlog="${XDG_RUNTIME_DIR:-/tmp}/dotfiles-errors.$$"
alias inspect='cat "${_errlog}"'

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bash"

{

source "${XDG_DATA_HOME:-$HOME/.local/share}/bashlib/lib.bash"
import_lib "common" "log" "path"

for _rc in "${config_dir}"/{lib/*,core/*,bash_plugins,bash_aliases,bash_functions}; do
  [[ -f $_rc ]] || continue
  case $_rc in
    # Env-style files: plain KEY=value lines, shared with environment.d via
    # symlinks, so they contain no `export`. Auto-export them while sourcing.
    */core/10-xdg.sh | */core/20-envars.bash)
      set -a
      source "$_rc"
      set +a
      ;;
    *)
      source "$_rc"
      ;;
  esac
done
unset _rc


THEME_VARIANT=dark
__theme::init default && __theme::main_handle

if [[ -s $_errlog ]]; then
  echo "Using Minimal config"
  source "$config_dir/bashrc_minimal"
fi

# local config file
local_bashrc="${config_dir}/bashrc_local"
if [[ -f "${local_bashrc}" ]]; then
  source "${local_bashrc}" || echo "Warning: failed to load basrc_local" >&2
fi
unset local_bashrc

unset config_dir


} 2> "$_errlog"


if [[ -s $_errlog ]]; then
  printf 'bashrc: load errors (run: inspect)\n' >&2
else
  rm -f "$_errlog"
fi
