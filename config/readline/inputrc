# inputrc for libreadline
# See readline(3readline) and `info rluserman' for more information.

# Pass 8-bit (UTF-8) characters through unchanged, so umlauts and other
# non-ASCII text work. Readline already does this in a UTF-8 locale; these
# lines only matter if the locale isn't detected as UTF-8 (e.g. LANG=C).
# Side effect: terminals that send Meta as the 8th bit stop working as Meta.
# Nearly all modern terminals send Alt as ESC instead, so this rarely applies.
set convert-meta off
set input-meta on
set output-meta on

# always ring the terminal bell
set bell-style audible

# Case-insensitive completion, and list all matches on the first Tab
# instead of requiring a second press when the match is ambiguous.
set completion-ignore-case on
set show-all-if-ambiguous on

# when complete-ignore-case is On, treats '_' and '-'
# as the same when matching and completing.
set completion-map-case on

# display common completion prefix using the value of LS_COLORS
# for custom suffix 'readline-colored-completion-prefix'
set colored-completion-prefix on
set colored-stats on

# display the common prefix of the list of possible completions
# (which may be empty) before cycling through the list.
set menu-complete-display-prefix on

# Don't query user about viewing the number of possible completions
set completion-query-items 0

# Append a trailing slash when completing directories, including
# symlinks that point to directories, so you can keep typing the path.
# mark-directories is already on by default.
set mark-directories on
set mark-symlinked-directories on

# When completing in the middle of a word, skip over text after the cursor
# that already matches the end of the completion instead of duplicating it.
# For example, with the cursor on the "z" in "cd ~/src/mozil", <Tab>
# gives "cd ~/src/mozilla" rather than "cd ~/src/mozillazil".
set skip-completed-text on

# Append a character to completion listings that shows the file type:
# / for directories, * for executables, @ for symlinks, | for FIFOs,
# = for sockets.
set visible-stats on

# Do not use readline's pager (more) when showing completions.
set page-completions off

# always use vi
set editing-mode vi

# Vi Mode keybindings
$include ~/.config/readline/vimode
$include ~/.config/readline/surround
