#!/bin/sh
# shellcheck shell=sh
# vi:ft=sh fdm=marker ts=2 sw=2 et
#
# ~/.profile: executed by the command interpreter for login shells.
#
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login exists.
# see /usr/share/doc/bash/examples/startup-files for examples.
# the files are located in the bash-doc package.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

# if running bash
if [ -n "${BASH_VERSION:-}" ] && [ -f "$HOME/.bashrc" ]; then
  # include .bashrc if it exists
  . "$HOME/.bashrc"
  return
fi

core_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bash/core"
for f in "$core_dir"/*.sh; do
  [ -f "$f" ] || continue
  case $f in
    # Env-style files: plain KEY=value lines, shared with environment.d via
    # symlinks, so they contain no `export`. Auto-export them while sourcing.
    */10-xdg.sh)
      set -a
      . "$f"
      set +a
      ;;
    *)
      . "$f"
      ;;
  esac
done
unset core_dir f
