[module/backlight]
type = internal/backlight

; Use the card name you found in Step 1
card = intel_backlight

; Enable scroll actions to adjust brightness (requires xbacklight or brightnessctl)
enable-scroll = true

; Format for showing percentage
format = <ramp> <label>
