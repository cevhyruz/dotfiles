# vim: set ft=dosini :

[module/powermenu]
type = custom/menu

expand-right = true

format-spacing = 0
format-padding = 1
format-underline = #0a6cf5

label-open = " "
label-open-foreground = ${colors.secondary}
label-close =  cancel
label-close-foreground = ${colors.alert}
label-separator = │
label-separator-background = #000
label-separator-foreground = ${colors.foreground-alt}


separator-foreground = ${colors.alert}

menu-0-0-background = #000
menu-0-1-background = #000

menu-1-0-background = #000
menu-1-1-background = #000

menu-2-0-background = #000
menu-2-1-background = #000

menu-0-0 = reboot
menu-0-1 = power off
menu-0-0-exec = menu-open-1
menu-0-1-exec = menu-open-2

menu-1-0 = cancel
menu-1-0-exec = menu-open-0
menu-1-1 = reboot
menu-1-1-exec = sudo reboot

menu-2-0 = power off
menu-2-0-exec = sudo poweroff
menu-2-1 = cancel
menu-2-1-exec = menu-open-0

