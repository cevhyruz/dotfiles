# vim: set ft=dosini :

[bar/example]

width = 100%
height = 30pt
dpi = 96
margin-top = 5pt
margin-right = 5pt

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 2

border-size = 2pt
border-color = #285577

padding-left = 0
padding-right = 0

module-margin = 1

separator = "│"
separator-foreground = ${colors.alert}

# for text
font-0 = "JetBrainsMono Nerd Font:size=9;2"
# for icons
font-1 = "JetBrainsMono Nerd Font:size=15;1"

; font-1 = "FontAwesome:size=9;1"
; font-2 = siji:pixelsize=11;1

# [modules]
modules-left = i3 cpu memory zram diskswap scratchpad
modules-center = date mod1
modules-right = orientation temperature pulseaudio wlan battery backlight powermenu

cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true

;tray-position = right

; wm-restack = generic
; wm-restack = bspwm
# wm-restack = i3

; override-redirect = true
# The distance from the top of the screen
; offset-y = 0

# The distance from the sides (optional, for a floating look)

# Position the bar at the top
 bottom = false
