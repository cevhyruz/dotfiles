# vi:ft=i3config

# start dmenu (a program launcher)
# bindsym $mod+d exec --no-startup-id dmenu_run


# this is working
# bindsym $mod+f exec --no-startup-id rofi -show filebrowser

# show all windows
bindsym $mod+w exec --no-startup-id rofi -show window


set $floating_term_small --no-startup-id st -c 'float--center' -e bash -c

#===================================


# rofi (safe fallback)
bindsym $mod+f exec --no-startup-id rofi -show combi -run-command "i3-msg exec '{cmd}'"

# [/] Working d-menu
bindsym $mod+d exec $floating_term_small "~/Projects/dotfiles/src/i3wm/bin/launcher.bash"


#===================================
# open my notes
bindsym $mod+Shift+n exec $floating_term_small "~/Projects/dotfiles/src/i3wm/bin/notes-launcher.bash"


# Adjust screen brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# enter fullscreen mode for the focused container
bindsym $mod+Shift+f fullscreen toggle

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# the classic alt+tab behavior
bindsym $mod+Tab workspace back_and_forth

set $layout_mode "layout: j=next k=prev Esc=exit"

# toggling layout
bindsym $mod+t layout toggle stacking tabbed
bindsym $mod+e layout toggle split

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
# bindsym $Green_Grass.jpg focus the child container
# bindsym $mod+d focus child

# different ways of launching a terminal
set $term gnome-terminal
bindsym $mod+Return exec $term
bindsym $mod+Shift+t exec $floatterm $float_normal
#
# modes
bindsym $mod+v mode "adjust volume"
bindsym $mod+o mode "orientation"
bindsym $mod+r mode "resize"
bindsym $mod+g mode "toggle gaps"
bindsym $mod+m mode "move window"
bindsym $mod+s mode "scroll"

bindsym $mod+1  $switch $ws1
bindsym $mod+2  $switch $ws2
bindsym $mod+3  $switch $ws3
bindsym $mod+4  $switch $ws4
bindsym $mod+5  $switch $ws5
bindsym $mod+6  $switch $ws6
bindsym $mod+7  $switch $ws7
bindsym $mod+8  $switch $ws8
bindsym $mod+9  $switch $ws9
bindsym $mod+10 $switch $ws10

# Mouse+$mod to drag floating windows
floating_modifier $mod

# kill focused window
bindsym $mod+Shift+q kill

# change focus (hjkl)
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

# change focus (arrow keys)
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# move focused window (hjkl)
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right
# move focused window (arrow keys)
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# cycle through workspaces
bindsym $mod+n workspace next
bindsym $mod+p workspace prev

# reload the configuration file
bindsym $mod+Shift+c reload

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart

# exit i3 (logs you out of your X session)
# bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Quit i3?' -B 'Yes, exit i3' 'i3-msg exit'"

set $exit_mode exit: [e] confirm, [Escape] cancel

bindsym $mod+Shift+e mode "$exit_mode"

mode "$exit_mode" {
  bindsym e exec i3-msg exit
  bindsym Escape mode "default"
}
